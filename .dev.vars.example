# Local secrets for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# In staging/production set them with `wrangler secret put <NAME> [--env staging]`.

ENV=dev
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars   # openssl rand -base64 48
GEMINI_API_KEY=
SERP_API_KEY=                     # serpapi.com key (Google Shopping engine)
# RESEND_API_KEY=                 # resend.com key; empty = emails are only logged

# Local web portal
CORS_ORIGINS=http://localhost:3000
APP_FRONTEND_URL=http://localhost:3000

# Optional: Premium. Empty values disable the feature (verify returns 503, pushes are skipped).
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # one line of JSON
# PLAY_RTDN_TOKEN=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# APPLE_ENVIRONMENT=Sandbox
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
