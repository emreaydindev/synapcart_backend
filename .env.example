# Copy to .env and fill in. Required keys have no default.

ENV=dev                      # "prod" disables /docs and enforces a strong SECRET_KEY
SECRET_KEY=                  # python -c "import secrets; print(secrets.token_urlsafe(48))"
DATABASE_URL=sqlite:///./synapcart.db

GEMINI_API_KEY=
SERP_API_KEY=                # serpapi.com key (Google Shopping engine)

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

APP_FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# RESET_TOKEN_EXPIRE_HOURS=1
# DELETE_TOKEN_EXPIRE_HOURS=24
# AUTO_MIGRATE=true
# AGENT_RATE_LIMIT=20/minute
# MAX_MESSAGE_LENGTH=1000

# Premium (Phase 2). Unset billing/FCM keys disable those features.
# PREMIUM_ANALYST_MODEL=gemini-2.5-flash
# PLAY_PACKAGE_NAME=com.neilb.synapcart
# PLAY_SUBSCRIPTION_IDS=synapcart_premium
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=   # service account key JSON (content or file path)
# PLAY_RTDN_TOKEN=                    # Pub/Sub push URL: /api/v1/billing/google/rtdn?token=<this>
# FIREBASE_SERVICE_ACCOUNT_JSON=      # FCM sender key JSON (content or file path)
# FIREBASE_PROJECT_ID=                # defaults to the key's project_id
